   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "strata-prometheus"
     },
     "expr": "DCGM_FI_DEV_POWER_USAGE / DCGM_FI_DEV_ENFORCED_POWER_LIMIT",
     "legendFormat": "{{role}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1.1
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "GPU temperature (memory junction needs the memtemp profile)",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "strata-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 6
