{
 "title": "Rig health",
 "uid": "rig-health",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "15s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "tags": [
  "strata-local"
 ],
 "panels": [
  {
   "type": "row",
   "title": "Health",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Strata scrape",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "strata-prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "strata-prometheus"
     },
     "expr": "up{job=\"strata\"}",
     "legendFormat": "strata",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN"
        },
        "1": {
         "text": "UP"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   }
  },
