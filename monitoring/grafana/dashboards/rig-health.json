  {
   "type": "state-timeline",
   "title": "Why the GPU clock is limited (power cap is expected at 300/350 W; red is a fault)",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "strata-prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 22
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "strata-prometheus"
     },
     "expr": "floor(DCGM_FI_DEV_CLOCKS_EVENT_REASONS / 4) % 2",
     "legendFormat": "{{role}} power cap",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "strata-prometheus"
     },
     "expr": "floor(DCGM_FI_DEV_CLOCKS_EVENT_REASONS / 8) % 2",
     "legendFormat": "{{role}} hw slowdown",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "strata-prometheus"
     },
     "expr": "floor(DCGM_FI_DEV_CLOCKS_EVENT_REASONS / 32) % 2",
     "legendFormat": "{{role}} sw thermal",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "strata-prometheus"
     },
     "expr": "floor(DCGM_FI_DEV_CLOCKS_EVENT_REASONS / 64) % 2",
     "legendFormat": "{{role}} hw thermal",
     "refId": "D"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "strata-prometheus"
     },
     "expr": "floor(DCGM_FI_DEV_CLOCKS_EVENT_REASONS / 128) % 2",
     "legendFormat": "{{role}} power brake",
     "refId": "E"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "ok",
         "color": "green"
        }
       }
      }
     ],
     "custom": {
      "fillOpacity": 80
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "ok",
            "color": "green"
           },
           "1": {
            "text": "limiting",
            "color": "orange"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "B"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "ok",
            "color": "green"
           },
           "1": {
            "text": "limiting",
            "color": "red"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "C"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "ok",
            "color": "green"
           },
           "1": {
            "text": "limiting",
            "color": "red"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "D"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "ok",
            "color": "green"
           },
           "1": {
            "text": "limiting",
            "color": "red"
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "E"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "ok",
            "color": "green"
           },
           "1": {
            "text": "limiting",
            "color": "red"
           }
          }
         }
