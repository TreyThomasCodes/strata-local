    "y": 47
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "strata-prometheus"
     },
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
