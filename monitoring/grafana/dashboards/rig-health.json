   "id": 23,
   "datasource": {
    "type": "prometheus",
    "uid": "strata-prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 47
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "strata-prometheus"
     },
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "used",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
