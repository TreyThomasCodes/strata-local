# Rendered by the prometheus entrypoint. The GPU UUID placeholders come from .env.
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: strata
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /run/secrets/strata_api_key
    static_configs:
      - targets: ["strata:8080"]

  - job_name: dcgm
    static_configs:
      - targets: ["dcgm-exporter:9400"]
    metric_relabel_configs:
      - source_labels: [UUID]
        regex: "@PRIMARY_GPU_UUID@"
        target_label: role
        replacement: primary
      - source_labels: [UUID]
        regex: "@PEER_GPU_UUID@"
        target_label: role
        replacement: peer
      - regex: UUID
        action: labeldrop

  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]
