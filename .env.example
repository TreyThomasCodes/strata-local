# Copy to .env (ignored by Git), then replace the GPU placeholders.
# Find UUIDs: nvidia-smi --query-gpu=index,uuid --format=csv
# Original rig: physical GPU1 primary; physical GPU0 peer.
PRIMARY_GPU_UUID=GPU-REPLACE-WITH-PRIMARY-UUID
PEER_GPU_UUID=GPU-REPLACE-WITH-PEER-UUID
PRIMARY_POWER_W=300
PEER_POWER_W=350
STRATA_DATA_DIR=/opt/ai/Strata-data
# Engine profile under config/. Default: strata-iq3_s.json.
# Orca comparison: strata-orca-iq3_xxs.json (needs its own models and pack).
#STRATA_CONFIG=strata-orca-iq3_xxs.json
# Local-only by default. Set 0.0.0.0 for trusted LAN access. The server takes no API key.
STRATA_BIND_HOST=127.0.0.1
# Host names LAN clients use for this server, comma-separated. IP addresses always work.
#STRATA_ALLOWED_HOSTS=rig.lan
STRATA_PORT=8080

# Optional monitoring (compose.monitoring.yaml).
# MONITORING_UID must own the Grafana password file and both data dirs.
# Create them first: mkdir -p "$MONITORING_DATA_DIR"/{prometheus,grafana}
MONITORING_UID=1000
MONITORING_DATA_DIR=/opt/ai/Strata-monitoring
GRAFANA_ADMIN_PASSWORD_FILE=/opt/ai/Strata-secrets/grafana-admin-password
GRAFANA_BIND_HOST=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_RETENTION=30d

# Optional memory junction temperature (memtemp profile). Lowercase PCI bus IDs.
# Find: nvidia-smi --query-gpu=uuid,pci.bus_id --format=csv,noheader
# Drop the leading 0000 from 00000000:0A:00.0 and lowercase it: 0000:0a:00.0
PRIMARY_PCI_BUS_ID=0000:00:00.0
PEER_PCI_BUS_ID=0000:00:00.0
